{
  "name": "hard-down-after-dwell",
  "description": "Same hard-down incumbent as dwell-blocks-switch but the dwell window has elapsed, so the switch goes through immediately.",
  "config": {
    "base_lp": 200,
    "lp_step": 50,
    "margin_ms": 10,
    "win_cycles": 2,
    "dwell_seconds": 60,
    "max_switches": 2,
    "loss_drop_pct": 5
  },
  "state": {
    "primary": "a",
    "last_switch_ago_seconds": 3600,
    "switch_hour_wnd": 0,
    "frozen": false
  },
  "steps": [
    {
      "health": [
        {
          "name": "a",
          "session_up": false,
          "loss_pct": 0,
          "ewma_ms": 0
        },
        {
          "name": "b",
          "session_up": true,
          "loss_pct": 0,
          "ewma_ms": 10
        }
      ],
      "expect": {
        "primary": "b",
        "switched": true,
        "reason": "incumbent hard-down or loss-excluded",
        "frozen": false,
        "assigned_lp": {
          "b": 200
        }
      }
    }
  ]
}
