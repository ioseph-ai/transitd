{
  "name": "dwell-blocks-switch",
  "description": "Incumbent hard-down immediately after a switch: the failover is warranted but dwell suppresses it this cycle. The incumbent stays primary; only the eligible challenger gets an LP entry because the downed incumbent is excluded from ranking.",
  "config": {
    "base_lp": 200,
    "lp_step": 50,
    "margin_ms": 10,
    "win_cycles": 2,
    "dwell_seconds": 60,
    "max_switches": 2,
    "loss_drop_pct": 5
  },
  "state": {
    "primary": "a",
    "last_switch_ago_seconds": 0,
    "switch_hour_wnd": 0,
    "frozen": false
  },
  "steps": [
    {
      "health": [
        {
          "name": "a",
          "session_up": false,
          "loss_pct": 0,
          "ewma_ms": 0
        },
        {
          "name": "b",
          "session_up": true,
          "loss_pct": 0,
          "ewma_ms": 10
        }
      ],
      "expect": {
        "primary": "a",
        "switched": false,
        "reason": "switch suppressed: dwell",
        "frozen": false,
        "assigned_lp": {
          "b": 200
        }
      }
    }
  ]
}
